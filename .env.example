# Transport Configuration
# Choose between 'stdio' (default) or 'http'
# - stdio: Standard input/output (for MCP clients like Claude Code/Desktop)
# - http: HTTP Streamable transport (for web clients)
TRANSPORT=stdio

# HTTP Transport Configuration (only used when TRANSPORT=http)
PORT=3000
HOST=0.0.0.0

# CORS Origins (only used when TRANSPORT=http)
# Comma-separated list of allowed origins, or "*" for all origins
# Default: http://localhost:6274,https://mcp.ziziyi.com
CORS_ORIGINS=http://localhost:6274,https://mcp.ziziyi.com

# Logging Configuration
LOG_LEVEL=info

# Sentry Error Monitoring (optional — GDPR/RODO compliant)
# Set SENTRY_DSN to enable. When not set, Sentry is completely disabled (no-op).
# Only server errors and startup events are captured.
# Tool inputs and user data are NEVER sent to Sentry.
# Works identically for npx/stdio and Docker/HTTP deployments.
#
# SENTRY_DSN=https://your-key@o0.ingest.sentry.io/your-project-id
#
# SENTRY_ENVIRONMENT=production   # optional; SDK reads this env var automatically
# SENTRY_RELEASE=3.8.0            # optional; defaults to the npm package version
